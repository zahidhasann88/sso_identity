# Copy to .env:  cp .env.example .env
# Defaults are for local development. "Prod:" lines show production values.

# --- Django ---
# Prod: DJANGO_DEBUG=0
DJANGO_DEBUG=1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
# Prod (required): DJANGO_ALLOWED_HOSTS=sso.example.com

# --- Database (PostgreSQL) ---
DB_NAME=sso_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Prod: DB_SSLMODE=require
# Or one URL instead of DB_*: DATABASE_URL=postgres://user:pass@db:5432/sso_db

# --- Signing key (default: keys/jwt_private.pem) ---
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PRIVATE_KEY_PASSPHRASE=
# Old public key to keep accepting during key rotation:
# JWT_ADDITIONAL_PUBLIC_KEY_PATHS=keys/jwt_public.previous.pem

# --- Tokens ---
JWT_ALGORITHM=RS256
JWT_ISSUER=https://sso.example.com
JWT_AUDIENCE=billing-api,orders-api,web-app
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_LEEWAY_SECONDS=10
JWT_ROTATE_REFRESH_TOKENS=1
# Keep on: required for stolen-token (replay) detection.
JWT_BLACKLIST_AFTER_ROTATION=1

# --- Revocation store: db | redis | chained ---
JWT_BLACKLIST_BACKEND=db
# REDIS_URL=redis://redis:6379/0

# --- Cache (Prod: use Redis when running several workers) ---
# CACHE_URL=redis://redis:6379/1

# --- Reverse proxy (enable only behind a proxy that overwrites X-Forwarded-*) ---
TRUST_PROXY_HEADERS=0
TRUST_PROXY_COUNT=1

# --- Rate limits & passwords ---
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_REFRESH=30/min
THROTTLE_LOGOUT=20/min
THROTTLE_INTROSPECT=60/min
THROTTLE_PASSWORD_CHANGE=5/min
LOGIN_FAILURE_LIMIT=8
LOGIN_FAILURE_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=12
LOG_LEVEL=INFO
