# ---------------------------------------------------------------------------
# Copy to .env and fill in. Real environment variables always take precedence,
# so containers can inject config without a .env file present.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_ALLOWED_HOSTS=sso.example.com,identity.internal

# ---------------------------------------------------------------------------
# Database — PostgreSQL (the only supported engine).
# Supply the discrete DB_* values, or a single DATABASE_URL which wins.
# ---------------------------------------------------------------------------
DB_NAME=sso_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
# DATABASE_URL=postgres://identity:secret@db:5432/identity

# ---------------------------------------------------------------------------
# RSA signing key — supply ONE of these.
#   1. JWT_PRIVATE_KEY_PATH: path to a PKCS#8 PEM file (chmod 600)
#   2. JWT_PRIVATE_KEY:      the PEM itself, literal \n escapes allowed
# Generate with: python manage.py generate_jwt_keys --size 4096 --print-env
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----\n"
# JWT_PRIVATE_KEY_PASSPHRASE=

# ---------------------------------------------------------------------------
# Key rotation overlap. Public keys listed here keep verifying but no longer
# sign, so tokens issued before a rotation stay valid until they expire. Give
# the retired PUBLIC key here for one access-token lifetime after rotating,
# then remove it. Either form may hold several PEM blocks.
# ---------------------------------------------------------------------------
# JWT_ADDITIONAL_PUBLIC_KEY_PATHS=/run/secrets/jwt_public.previous.pem
# JWT_ADDITIONAL_PUBLIC_KEYS="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"

# ---------------------------------------------------------------------------
# Token policy
# ---------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_ISSUER=https://sso.example.com
JWT_AUDIENCE=billing-api,orders-api,web-app
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_LEEWAY_SECONDS=10
JWT_ROTATE_REFRESH_TOKENS=1
# Leave this on. With rotation enabled and this disabled, the old refresh token
# is never consumed, so replay detection cannot fire and one stolen token mints
# sessions until it expires (reported as identity.W004).
JWT_BLACKLIST_AFTER_ROTATION=1

# ---------------------------------------------------------------------------
# Revocation store: db | redis | chained
# ---------------------------------------------------------------------------
JWT_BLACKLIST_BACKEND=db
# REDIS_URL=redis://redis:6379/0
# JWT_BLACKLIST_REDIS_PREFIX=sso:jti:revoked:

# ---------------------------------------------------------------------------
# Cache. Throttle counters and login-failure counters live here, so every
# process that serves traffic has to share it. Without CACHE_URL the cache is
# per-process local memory: fine for one process, but with N gunicorn workers
# every limit below is effectively multiplied by N. `manage.py check --deploy`
# warns (identity.W001) when DEBUG is off and this is still unset.
# ---------------------------------------------------------------------------
# CACHE_URL=redis://redis:6379/1
# CACHE_KEY_PREFIX=sso

# ---------------------------------------------------------------------------
# Reverse proxy. Turn this on only when a proxy that *overwrites*
# X-Forwarded-For and X-Forwarded-Proto sits in front of the service.
# Otherwise both headers are attacker-controlled: a client could fake HTTPS
# and mint itself a fresh throttle/lockout bucket on every request.
# TRUST_PROXY_COUNT is how many proxies append to X-Forwarded-For.
# ---------------------------------------------------------------------------
TRUST_PROXY_HEADERS=0
TRUST_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# HTTPS enforcement. Both apply only when DJANGO_DEBUG=0. Turn the redirect
# off where something in front already guarantees TLS (or in a test runner
# that speaks plain HTTP), and shorten HSTS while first rolling it out.
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Load and validate the signing key at startup instead of on the first
# request, so a bad key or algorithm fails the deploy rather than a caller.
# ---------------------------------------------------------------------------
# JWT_WARM_KEYRING_ON_BOOT=1

# ---------------------------------------------------------------------------
# Abuse controls
# ---------------------------------------------------------------------------
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_REFRESH=30/min
THROTTLE_LOGOUT=20/min
THROTTLE_INTROSPECT=60/min
THROTTLE_PASSWORD_CHANGE=5/min
LOGIN_FAILURE_LIMIT=8
LOGIN_FAILURE_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=12
LOG_LEVEL=INFO
